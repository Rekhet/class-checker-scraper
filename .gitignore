# The deployment site is a separate public Git repository.
/web/

# Local tooling and generated Python artifacts.
/.venv/
/.agents/
/.codex/
/.claude/
__pycache__/
*.py[cod]
*.egg-info/

# Graph/indexing output and scratch directories.
/graphify-out/
/docs/graphify-out/
/_scrape/
/tmp/
/data/grad_req/_scrape/

# Runtime databases, crawl state, logs, and fetched source artifacts.
/data/*.db
/data/*.db-*
/data/.crawl.lock
/data/logs/
/data/trend_cache/
/data/root.html
/data/sample_excel.bin
/data/trend_archive_pre2026/

# Credentials and machine-local environment files. The semester/window
# configuration is intentionally tracked in the private automation repository.
/prod.env
/prod-admin.env
/google_oauth_secret.json
.env
.env.*
!/collect.env
!/collect.env.example

# Local request/response captures, not application source.
/cc100ajax.json
/form2.txt
/page2.txt
/sample_response.txt
/search_form.txt

# Common editor and OS files.
.DS_Store
*.swp
*~

# Remote Turso credentials for the cloud counts pull (never commit).
/turso-remote.env
/data/pull_counts.state

# backups/ is tracked for its README and sample exports, so anything dropped
# there by hand — an old credential file, a database copy made during
# recovery — has to be excluded explicitly. This repository is public.
/backups/*.env
/backups/*.env.*
/backups/*.db
/backups/*.db-*
/backups/*.sqlite*
