[Unit]
Description=SNU Class Checker bounded cart collection (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/project/class-checker
EnvironmentFile=%h/.config/systemd/user/class-checker.cart-window-%i.env
# Keep Playwright's temporary Chromium profiles in the user runtime filesystem,
# rather than the shared /tmp filesystem that can fill independently.
RuntimeDirectory=class-checker
RuntimeDirectoryMode=0700
Environment=TMPDIR=%t/class-checker
ExecStart=%h/project/class-checker/scripts/update-counts.sh
TimeoutStartSec=20min
