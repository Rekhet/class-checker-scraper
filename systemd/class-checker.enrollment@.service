[Unit]
Description=SNU Class Checker bounded enrollment collection (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/project/class-checker
EnvironmentFile=%h/.config/systemd/user/class-checker.enrollment-window-%i.env
RuntimeDirectory=class-checker
RuntimeDirectoryMode=0700
Environment=TMPDIR=%t/class-checker
ExecStart=%h/project/class-checker/scripts/update-counts.sh
TimeoutStartSec=20min
