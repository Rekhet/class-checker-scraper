[Unit]
Description=SNU Class Checker bounded enrollment cleanup (%i)

[Service]
Type=oneshot
WorkingDirectory=%h/project/class-checker
ExecStart=%h/project/class-checker/.venv/bin/python %h/project/class-checker/scripts/cleanup_cart_window.py --kind enrollment --window-id %i --unit-dir %h/.config/systemd/user --wait-timeout 1800
TimeoutStartSec=35min
