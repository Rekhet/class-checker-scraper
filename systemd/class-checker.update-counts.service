[Unit]
Description=SNU Class Checker cart/trend update

[Service]
Type=oneshot
WorkingDirectory=%h/project/class-checker
# Scope, mode, timezone, and collection windows are sourced from collect.env by
# the entry point. This unit intentionally contains no semester-specific values.
Environment=CRAWL_LOCK_TIMEOUT=900
ExecStart=%h/project/class-checker/scripts/update-counts.sh
TimeoutStartSec=20min
