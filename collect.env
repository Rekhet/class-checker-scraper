# Canonical semester and collection windows; sourced by local scripts and
# GitHub runners. Dates are inclusive in COLLECTION_TIMEZONE.
# A metric outside its windows is NULL; outside every window no pass is written.
# COUNT_* explicit environment overrides remain supported for one-off commands.
#
# 2026 winter schedule, verified 2026-11-01 against SNU official notices:
# https://ie.snu.ac.kr/notice/?mid=ent_under&mod=document&uid=6517
# https://biosci.snu.ac.kr/board/notice?bbsidx=25596&bm=v&page=1v
#   Preliminary registration: 10-20..10-23 (already ended; no backfill).
#   Registration: 10-27..11-03, excluding Saturday/Sunday.
#   Changes: 11-11..11-13.
#   Cancellation: 12-11..2027-01-07.
#   Classes: 12-22..2027-01-25 (frontend config.js ICS range).
# Cart collection is local/bounded only; no expired cart timer is armed.
COUNT_YEAR="${COUNT_YEAR:-2026}"
COUNT_SEM="${COUNT_SEM:-winter}"
COUNT_MODE="${COUNT_MODE:-enrollment}"
COLLECTION_TIMEZONE="${COLLECTION_TIMEZONE:-Asia/Seoul}"

# The counted winter term is collected locally, then seeded into cloud classes.
# Only future spring remains in the remote catalog snapshot path.
UPCOMING_TERMS="${UPCOMING_TERMS:-2027:spring}"

CART_WINDOWS="${CART_WINDOWS:-2026-10-20..2026-10-23}"
ENROLL_WINDOWS="${ENROLL_WINDOWS:-2026-10-27..2026-10-30,2026-11-02..2026-11-03,2026-11-11..2026-11-13}"
ENROLL_SLOW_WINDOWS="${ENROLL_SLOW_WINDOWS:-2026-12-11..2027-01-07}"
# Cancellation is still observed every 10 minutes, including weekends.
# Keep delta storage and daily keyframes; do not thin or prune this history.
ENROLL_SLOW_SLOT_MINUTES="${ENROLL_SLOW_SLOT_MINUTES:-60}"
